# ── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
.venv/
.env

# ── Node / Frontend ─────────────────────────────────────────────────────────
node_modules/
dist/
build/
.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Databases ───────────────────────────────────────────────────────────────
# SQLite database created at runtime by the FastAPI backend
*.db
*.db-journal
*.sqlite3

# ── IDE / OS ────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# ── Generated evaluation artefacts ──────────────────────────────────────────
# These are regenerated by `python generate_synthetic_ids.py` and
# `python evaluate.py --generate --source synthetic_sources`.
# Reproducible from a fixed random seed (see generate_synthetic_ids.py).
synthetic_sources/

# Keep the evaluation_dataset/ folder structure in the repo, but ignore
# all generated images inside it.
evaluation_dataset/**/*.jpg
evaluation_dataset/**/*.jpeg
evaluation_dataset/**/*.png
